{
  "name": "lockwell",
  "private": true,
  "version": "0.1.0",
  "description": "A local-only, encrypted password and file manager for the desktop.",
  "license": "GPL-3.0-or-later",
  "author": "acevflow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acevflow/lockwell.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:coverage": "vitest run --coverage && npm run coverage:core",
    "coverage:core": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --no-report && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --html --output-dir coverage/core && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --lcov --output-path coverage/core/lcov.info && cargo llvm-cov report --manifest-path src-tauri/Cargo.toml --summary-only",
    "lint": "eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format": "prettier --write \"*.{js,ts,json,html}\" \"scripts/*.mjs\" \"src/**/*.{ts,tsx}\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\" \".vscode/*.json\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"*.{js,ts,json,html}\" \"scripts/*.mjs\" \"src/**/*.{ts,tsx}\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\" \".vscode/*.json\" && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "licenses": "node scripts/third-party-licenses.mjs",
    "licenses:check": "node scripts/third-party-licenses.mjs --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
