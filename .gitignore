# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Frontend (Vite / TypeScript)
dist/
dist-ssr/
build/
*.tsbuildinfo

# Rust / Tauri
target/
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk
*.pdb

# Packaged installers and bundles
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
coverage/
*.lcov
lcov.info
*.profraw
*.profdata
tarpaulin-report.html
cobertura.xml
junit.xml
test-results/

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.cache/
.vite/
.eslintcache
.stylelintcache
.prettiercache
.npm/
.pnpm-store/
*.tmp
*.temp

# ---------------------------------------------------------------------------
# Operating system files
# ---------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory
.Trash-*
.nfs*

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.history/
.fleet/
.zed/

# ---------------------------------------------------------------------------
# Secrets and credentials (never commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.asc
id_rsa*
id_ed25519*
/secrets/
# Tauri updater / code-signing private keys
*.tauri-key
tauri-private-key*

# ---------------------------------------------------------------------------
# Local development data (vaults, databases, decrypted files)
# Root-anchored so source modules such as src-tauri/src/vault/ are not ignored.
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-shm
*.db-wal
/vault/
/vaults/
/dev-data/
/local-data/

# Local overrides (Vite)
*.local
